	qcom,normal_phase5_bat_decidegc = <380>;
	qcom,temp_normal_phase5_vfloat_mv = <4435>;
	qcom,temp_normal_phase5_fastchg_current_ma = <2200>;
	qcom,normal_phase6_bat_decidegc = <400>;
	qcom,temp_normal_phase6_vfloat_mv = <4435>;
